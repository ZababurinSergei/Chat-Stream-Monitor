cd ~/Desktop/system/packages/mtproto-mqtt

# Создаем финальный патч
cat > /tmp/final_fix_connect.patch << 'EOF'
--- a/src/mesh-mqtt.c
+++ b/src/mesh-mqtt.c
@@ -688,6 +688,9 @@
     // 🔥 ИСПОЛЬЗУЕМ СТАНДАРТНЫЙ ИНИЦИАЛИЗАТОР
     MQTTClient_connectOptions conn_opts = MQTTClient_connectOptions_initializer;

+    // 🔥 ФИКС: устанавливаем правильную версию структуры
+    conn_opts.struct_version = 0;
