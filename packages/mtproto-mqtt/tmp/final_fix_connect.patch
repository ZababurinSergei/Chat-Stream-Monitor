     // 🔥 Проверяем структуру
     log_message("DEBUG", "conn_opts struct_id: %.4s, version: %d",
                 conn_opts.struct_id, conn_opts.struct_version);
@@ -722,6 +725,10 @@
                 conn_opts.username ? conn_opts.username : "(null)",
                 conn_opts.password ? "***" : "(null)");

+    // 🔥 Дополнительная проверка перед вызовом
