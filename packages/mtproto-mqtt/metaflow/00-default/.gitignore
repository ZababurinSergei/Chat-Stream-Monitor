# -------------------- Specific Rules --------------------
# Keep important files
!package.json
!package-lock.json
!.env.example
!.gitignore
!README.md
!INTERFACE.md
!request.http

# Keep source files
!src/**/*.c
!src/**/*.h
!include/**/*.h
!scripts/**/*.sh
!scripts/**/*.py

# Keep config examples
!config/*.example.*
!*.example.yaml
!*.example.yml
!*.example.json
!*.example.toml

# Keep test files
!test/**/*.c
!test/**/*.js
!test/**/*.py
!test/**/*.sh

# Keep documentation
!docs/**/*.md
!*.md
!LICENSE
!CHANGELOG.md
!CONTRIBUTING.md
