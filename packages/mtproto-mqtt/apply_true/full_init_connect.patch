# Создаем исправление с полной инициализацией
cat > /tmp/full_init_connect.patch << 'EOF'
--- a/src/mesh-mqtt.c
+++ b/src/mesh-mqtt.c
@@ -685,8 +685,11 @@
         return -1;
     }

