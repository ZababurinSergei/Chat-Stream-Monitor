{
  "name": "@newkind/tsgen-core",
  "version": "2.0.0",
  "type": "module",
  "description": "TypeScript configuration generator for monorepos with multi-builder support",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tsgen": "./dist/index.js",
    "nk-tsgen": "./dist/index.js"
  },
  "scripts": {
    "👉 ГЕНЕРАЦИЯ TSCONFIG": "#",
    "tsconfig:generate": "node dist/index.js generate",
    "tsconfig:generate:root": "node dist/index.js root",
    "tsconfig:check": "node dist/index.js check",
    "tsconfig:help": "node dist/index.js help",
    "tsconfig:demo": "npm run tsconfig:demo:setup && npm run tsconfig:demo:generate",
    "tsconfig:demo:setup": "mkdir -p demo/packages/{frontend-app,backend-api,shared-utils} && echo '{\"name\":\"demo-monorepo\",\"workspaces\":[\"packages/*\"]}' > demo/package.json",
    "tsconfig:demo:generate": "cd demo && npx .. generate",
    "tsconfig:demo:check": "cd demo && npx .. check",
    "tsconfig:validate": "npm run tsconfig:generate && npm run tsconfig:check",

    "👉 СБОРКА И КОМПИЛЯЦИЯ": "#",
    "build:production": "tsc --declaration false --sourceMap false",
    "build:clean": "npm run clean && npm run build",

    "👉 РАЗРАБОТКА": "#",
    "dev": "tsc --watch",
    "dev:debug": "tsc --watch --preserveWatchOutput",
    "start": "node dist/index.js",
    "start:dev": "node --watch dist/index.js",

    "👉 ТЕСТИРОВАНИЕ": "#",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit",
    "test:integration": "vitest run tests/integration",
    "test:tsconfig": "npm run tsconfig:demo && npm run test:integration",

    "👉 TYPE-CHECK И ЛИНТИНГ": "#",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "type-check:strict": "tsc --noEmit --strict",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",

    "👉 CLI И УТИЛИТЫ": "#",
    "generate": "npm run tsconfig:generate",
    "generate:root": "npm run tsconfig:generate:root",
    "check": "npm run tsconfig:check",
    "help": "npm run tsconfig:help",
    "version:show": "node dist/index.js version",

    "👉 CLI УСТАНОВКА И ПУБЛИКАЦИЯ": "#",
    "cli:install": "npm run build && npm run cli:make-executable && npm run cli:link",
    "cli:make-executable": "chmod +x dist/index.js",
    "cli:link": "npm link",
    "cli:unlink": "npm unlink -g @newkind/tsgen-core",
    "cli:global": "npm install -g .",
    "cli:local": "npm install .",
    "cli:publish": "npm publish --access public",
    "cli:publish:dry-run": "npm publish --access public --dry-run",

    "👉 ОЧИСТКА": "#",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist node_modules coverage .tsbuildinfo demo",
    "clean:cache": "rm -rf node_modules/.cache .vitest",
    "clean:demo": "rm -rf demo",

    "👉 ДЕМО И ПРИМЕРЫ": "#",
    "demo": "npm run tsconfig:demo",
    "demo:frontend": "mkdir -p demo/packages/frontend-app/src && echo '{\"name\":\"frontend-app\",\"devDependencies\":{\"vite\":\"^5.0.0\"}}' > demo/packages/frontend-app/package.json",
    "demo:backend": "mkdir -p demo/packages/backend-api/src && echo '{\"name\":\"backend-api\",\"dependencies\":{\"express\":\"^4.18.0\"}}' > demo/packages/backend-api/package.json",
    "demo:shared": "mkdir -p demo/packages/shared-utils/src && echo '{\"name\":\"@shared/utils\"}' > demo/packages/shared-utils/package.json",
    "demo:full": "npm run demo:frontend && npm run demo:backend && npm run demo:shared && npm run tsconfig:demo:generate",

    "👉 ВАЛИДАЦИЯ И ПРОВЕРКИ": "#",
    "validate": "npm run type-check && npm run test && npm run build",
    "validate:full": "npm run lint && npm run type-check && npm run test && npm run build && npm run tsconfig:validate",
    "validate:tsconfig": "npm run tsconfig:demo && npm run tsconfig:check",
    "prepublishOnly": "npm run validate:full",
    "prepack": "npm run build",

    "👉 ОТЛАДКА": "#",
    "debug": "node --inspect dist/index.js generate",
    "debug:break": "node --inspect-brk dist/index.js generate",
    "debug:tsconfig": "node --inspect dist/index.js generate --verbose",

    "👉 ВСПОМОГАТЕЛЬНЫЕ": "#",
    "size": "du -sh dist/",
    "size:detailed": "find dist/ -name \"*.js\" -exec du -h {} \\;",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",

    "👉 ТЕСТИРОВАНИЕ БИЛДЕРОВ": "#",
    "test:builders": "npm run test:builders:vite && npm run test:builders:webpack && npm run test:builders:esbuild && npm run test:builders:node",
    "test:builders:vite": "node dist/index.js generate --builder=vite --type=frontend",
    "test:builders:webpack": "node dist/index.js generate --builder=webpack --type=frontend",
    "test:builders:esbuild": "node dist/index.js generate --builder=esbuild --type=frontend",
    "test:builders:node": "node dist/index.js generate --builder=node --type=backend",

    "👉 КОМБИНИРОВАННЫЕ СКРИПТЫ": "#",
    "build:with-vendor": "npm run build && npm run vendor:full",
    "dev:with-vendor": "npm run build && npm run vendor:build",
    "clean:with-vendor": "npm run clean && npm run vendor:clean",

    "👉 ПРОВЕРКИ VENDOR": "#",
    "vendor:validate": "npm run vendor:analyze && npm run vendor:build",
    "vendor:stats": "npm run vendor:analyze",
    "vendor:check": "npm run vendor:analyze",

    "👉 ДЕКЛАРАЦИИ TYPESCRIPT": "#",
    "build": "node scripts/build.js",
    "build:watch": "tsc --watch",
    "declarations:collect": "node scripts/declarations.js",
    "bundle:all-in-one": "node scripts/bundle.js -o tsgen --esm-only",

    "👉 VENDOR BUNDLE ГЕНЕРАЦИЯ": "#",
    "vendor:build": "node scripts/vendor.mjs build",
    "vendor:build:node": "node scripts/vendor.mjs build --platform node",
    "vendor:build:browser": "node scripts/vendor.mjs build --platform browser",
    "vendor:importmap": "node scripts/vendor.mjs importmap",
    "vendor:importmap:node": "node scripts/vendor.mjs importmap --platform node",
    "vendor:importmap:browser": "node scripts/vendor.mjs importmap --platform browser",
    "vendor:analyze": "node scripts/vendor.mjs analyze"
  }
}