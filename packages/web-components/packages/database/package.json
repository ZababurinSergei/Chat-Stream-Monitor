{
  "name": "the-last-of-guss-database",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "0": ".",
      "1": "/",
      "2": "d",
      "3": "i",
      "4": "s",
      "5": "t",
      "6": "/",
      "7": "i",
      "8": "n",
      "9": "d",
      "10": "e",
      "11": "x",
      "12": ".",
      "13": "j",
      "14": "s",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": "./dist/config/database.js",
    "./models": "./dist/models/index.js",
    "./types": "./dist/types/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outdir=dist --platform=browser",
    "build:watch": "esbuild src/index.ts --bundle --outdir=dist --platform=browser --watch",
    "dev": "npm run build:watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "esbuild": "^0.19.0"
  }
}