{
  "name": "@newkind/ast-api",
  "version": "1.0.0",
  "description": "AST Analyzer - AI Toolkit for code analysis, graph visualization, refactoring, semantic analysis, and formal verification",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ast-api": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "scripts": {
    "check": "npx tsc --noEmit --skipLibCheck",
    "check:fix": "npx tsc --noEmit --skipLibCheck --pretty",
    "build": "npm run clean && npx tsc",
    "build:watch": "npx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "graph": "npx @newkind/ast-analyzer compact-recursive ./src/index.ts --preset full --depth 1000 -o ./reports/project-graph.json",
    "graph:full": "npx @newkind/ast-analyzer compact-recursive ./src/index.ts --preset full --depth 2000 -o ./reports/project-graph-full.json",
    "graph:quick": "npx @newkind/ast-analyzer compact-recursive ./src/index.ts --preset quick --depth 500 -o ./reports/project-graph-quick.json",
    "analyze": "node ./dist/index.js",
    "analyze:project": "node ./dist/index.js project ./src/index.ts -o ./reports/analysis.json",
    "analyze:deep": "node ./dist/index.js project ./src/index.ts 15 -o ./reports/analysis-deep.json",
    "analyze:full": "node ./dist/index.js project ./src/index.ts 20 -o ./reports/analysis-full.json",
    "report": "node ./dist/index.js report ./src/index.ts -o ./reports/report.json",
    "report:html": "node ./dist/index.js report ./src/index.ts --format html -o ./reports/report.html",
    "report:markdown": "node ./dist/index.js report ./src/index.ts --format markdown -o ./reports/report.md",
    "refactor": "node ./dist/index.js refactor ./src/index.ts -o ./modules",
    "refactor:dry": "node ./dist/index.js refactor ./src/index.ts --dry-run",
    "dev": "tsx ./src/index.ts",
    "dev:watch": "tsx watch ./src/index.ts",
    "start": "node ./dist/index.js",
    "start:dev": "tsx ./src/index.ts",
    "serve": "node ./dist/server.js",
    "serve:dev": "tsx ./src/server.ts",
    "serve:watch": "tsx watch ./src/server.ts",
    "bundle": "esbuild ./src/index.ts --bundle --platform=node --format=esm --outfile=./dist/index.bundle.js",
    "bundle:min": "esbuild ./src/index.ts --bundle --platform=node --format=esm --minify --outfile=./dist/index.bundle.min.js",
    "bundle:all": "npm run bundle && npm run bundle:min",
    "prepare": "npm run build",
    "serve:tsx": "node ./dist/server.js",
    "serve:dev:tsx": "tsx ./src/server.ts",
    "serve:watch:tsx": "tsx watch ./src/server.ts",
    "dev:tsx": "npm run serve:dev",
    "report:ast-api": "ast-analyzer compact-recursive ./src/index.ts --preset full --depth 1000 -o ./src/index.json"
  },
  "keywords": [
    "ast",
    "analyzer",
    "static-analysis",
    "code-analysis",
    "graph",
    "visualization",
    "refactoring",
    "semantic",
    "typescript",
    "javascript",
    "vue"
  ],
  "author": "Zababurin Sergei",
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@codeflow-map/core": "^1.0.3",
    "@hpcc-js/dataflow": "^9.7.9",
    "@hpcc-js/wasm-graphviz": "^1.28.0",
    "@jitl/ts-simple-type": "^2.0.0-next.3",
    "@typescript-eslint/parser": "^8.26.1",
    "@vue/compiler-sfc": "^3.5.41",
    "cors": "^2.8.5",
    "eslint": "^10.8.1",
    "estree-walker": "^3.0.3",
    "execa": "^10.0.1",
    "express": "^4.18.2",
    "glob": "^13.0.6",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "^0.26.12",
    "z3-solver": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/estree": "^1.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^3.0.9",
    "@vitest/ui": "^3.0.9",
    "@vue/compiler-dom": "^3.5.41",
    "async-mutex": "^0.5.0",
    "commander": "^15.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "globals": "^17.11.0",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tree-sitter-wasms": "^0.1.13",
    "tsx": "^4.23.12",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src/utils/Logger.ts",
    "src/grammars/**/*.wasm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ZababurinSergei/ast-analyzer"
  },
  "bugs": {
    "url": "https://github.com/ZababurinSergei/ast-analyzer/issues"
  },
  "homepage": "https://github.com/ZababurinSergei/ast-analyzer#readme",
  "allowScripts": {
    "@newkind/ast-analyzer@3.1.1": true
  }
}
