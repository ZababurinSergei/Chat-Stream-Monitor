const cssContent = "/* CSS Bundle - Generated by esbuild */\n\n/* src/components/navigation-manager/css/index.css */\n:host {\n  display: flex;\n  flex-direction: column;\n}\n\n/* src/components/test-component-a/css/index.css */\n.test-component-a {\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    padding: var(--space-xl);\n    margin: var(--space) 0;\n    box-shadow: var(--shadow);\n    transition: var(--transition);\n}\n\n.test-component-a:hover {\n    box-shadow: var(--shadow-md);\n    border-color: var(--border-dark);\n}\n\n.test-component-a .title {\n    color: var(--primary);\n    margin: 0 0 var(--space) 0;\n    font-size: 1.5rem;\n    border-bottom: 2px solid var(--primary);\n    padding-bottom: var(--space-sm);\n    font-weight: 600;\n}\n\n.test-component-a .counter {\n    background: var(--primary-50);\n    color: var(--primary-dark);\n    padding: var(--space);\n    border-radius: var(--radius);\n    font-weight: bold;\n    text-align: center;\n    margin-bottom: var(--space-lg);\n    border: 1px solid var(--primary-100);\n    font-size: 1.1rem;\n    transition: var(--transition);\n}\n\n.test-component-a .counter:hover {\n    background: var(--primary-100);\n    transform: translateY(-1px);\n}\n\n.test-component-a .controls {\n    display: flex;\n    gap: var(--space);\n    margin-bottom: var(--space-lg);\n    flex-wrap: wrap;\n}\n\n.test-component-a .controls .yato-button {\n    flex: 1;\n    min-width: 120px;\n    transition: var(--transition);\n}\n\n.test-component-a .controls .yato-button:hover {\n    transform: translateY(-2px);\n}\n\n.test-component-a .add-form {\n    display: flex;\n    gap: var(--space);\n    margin-bottom: var(--space-lg);\n    align-items: stretch;\n}\n\n.test-component-a .add-form input {\n    flex: 1;\n    padding: var(--space);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    background: var(--surface);\n    color: var(--text);\n    font-family: inherit;\n    transition: var(--transition);\n    min-width: 0;\n}\n\n.test-component-a .add-form input:focus {\n    border-color: var(--primary);\n    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 20%, transparent);\n    outline: none;\n}\n\n.test-component-a .add-form input::placeholder {\n    color: var(--text-tertiary);\n}\n\n.test-component-a .add-form button {\n    white-space: nowrap;\n    transition: var(--transition);\n}\n\n.test-component-a .add-form button:hover {\n    transform: translateY(-1px);\n}\n\n.test-component-a .items-list {\n    margin-bottom: var(--space-lg);\n}\n\n.test-component-a .items-list h3 {\n    color: var(--text);\n    margin-bottom: var(--space);\n    font-size: 1.1rem;\n    font-weight: 600;\n}\n\n.test-component-a .items-list ul {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n}\n\n.test-component-a .item {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: var(--space);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    margin-bottom: var(--space-sm);\n    background: var(--surface-50);\n    transition: var(--transition);\n    animation: fadeIn 0.3s ease-out;\n}\n\n.test-component-a .item:hover {\n    background: var(--surface-100);\n    border-color: var(--border-dark);\n    transform: translateX(4px);\n}\n\n.test-component-a .item:last-child {\n    margin-bottom: 0;\n}\n\n.test-component-a .btn-remove {\n    background: var(--danger);\n    color: white;\n    border: none;\n    border-radius: var(--radius);\n    width: 32px;\n    height: 32px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 1.2rem;\n    cursor: pointer;\n    transition: var(--transition);\n    flex-shrink: 0;\n}\n\n.test-component-a .btn-remove:hover {\n    background: var(--danger-dark);\n    transform: scale(1.1);\n}\n\n.test-component-a .btn-remove:active {\n    transform: scale(0.95);\n}\n\n.test-component-a .component-info {\n    text-align: center;\n    color: var(--text-tertiary);\n    font-style: italic;\n    padding-top: var(--space);\n    border-top: 1px solid var(--border);\n    font-size: 0.875rem;\n}\n\n/* Анимации */\n@keyframes fadeIn {\n    from {\n        opacity: 0;\n        transform: translateY(10px);\n    }\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n.test-component-a .item {\n    animation: fadeIn 0.3s ease-out;\n}\n\n/* Состояния загрузки */\n.test-component-a .skeleton-container .item {\n    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%) !important;\n    background-size: 200% 100% !important;\n    animation: skeleton-loading 1.5s infinite !important;\n}\n\n/* Темная тема */\n[data-theme=\"dark\"] .test-component-a {\n    background: var(--surface);\n    border-color: var(--border);\n}\n\n[data-theme=\"dark\"] .test-component-a .counter {\n    background: var(--primary-50);\n    color: var(--primary-100);\n    border-color: var(--primary);\n}\n\n[data-theme=\"dark\"] .test-component-a .item {\n    background: var(--surface-100);\n    border-color: var(--border);\n}\n\n[data-theme=\"dark\"] .test-component-a .item:hover {\n    background: var(--surface-200);\n    border-color: var(--border-dark);\n}\n\n[data-theme=\"dark\"] .test-component-a .add-form input {\n    background: var(--surface);\n    border-color: var(--border);\n    color: var(--text);\n}\n\n[data-theme=\"dark\"] .test-component-a .add-form input:focus {\n    border-color: var(--primary);\n    background: var(--surface-50);\n}\n\n/* Адаптивность */\n@media (max-width: 768px) {\n    .test-component-a {\n        padding: var(--space-lg);\n        margin: var(--space-sm) 0;\n    }\n\n    .test-component-a .controls {\n        flex-direction: column;\n    }\n\n    .test-component-a .controls .yato-button {\n        min-width: auto;\n        width: 100%;\n    }\n\n    .test-component-a .add-form {\n        flex-direction: column;\n    }\n\n    .test-component-a .add-form input {\n        width: 100%;\n    }\n\n    .test-component-a .title {\n        font-size: 1.3rem;\n    }\n\n    .test-component-a .counter {\n        font-size: 1rem;\n        padding: var(--space-sm) var(--space);\n    }\n}\n\n@media (max-width: 480px) {\n    .test-component-a {\n        padding: var(--space);\n        border-radius: var(--radius);\n    }\n\n    .test-component-a .item {\n        padding: var(--space-sm);\n        flex-direction: column;\n        align-items: flex-start;\n        gap: var(--space-sm);\n    }\n\n    .test-component-a .btn-remove {\n        align-self: flex-end;\n        margin-top: -40px;\n    }\n\n    .test-component-a .title {\n        font-size: 1.2rem;\n        text-align: center;\n    }\n}\n\n/* Состояния фокуса для доступности */\n.test-component-a .yato-button:focus-visible,\n.test-component-a .add-form input:focus-visible,\n.test-component-a .btn-remove:focus-visible {\n    outline: 2px solid var(--primary);\n    outline-offset: 2px;\n}\n\n/* Высокий контраст */\n@media (prefers-contrast: high) {\n    .test-component-a {\n        border: 2px solid var(--text);\n    }\n\n    .test-component-a .item {\n        border: 1px solid var(--text);\n    }\n\n    .test-component-a .btn-remove {\n        border: 1px solid var(--text);\n    }\n}\n\n/* Уменьшение движения */\n@media (prefers-reduced-motion: reduce) {\n    .test-component-a,\n    .test-component-a .item,\n    .test-component-a .yato-button,\n    .test-component-a .counter,\n    .test-component-a .btn-remove {\n        transition: none;\n        animation: none;\n    }\n\n    .test-component-a .item:hover {\n        transform: none;\n    }\n\n    .test-component-a .controls .yato-button:hover,\n    .test-component-a .add-form button:hover {\n        transform: none;\n    }\n\n    .test-component-a .btn-remove:hover {\n        transform: none;\n    }\n}\n\n/* src/components/test-component-b/css/index.css */\n.test-component-b {\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n    padding: var(--space-xl);\n    margin: var(--space) 0;\n    box-shadow: var(--shadow);\n}\n\n.test-component-b .header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: var(--space);\n    flex-wrap: wrap;\n    gap: var(--space);\n}\n\n.test-component-b .title {\n    color: var(--primary);\n    margin: 0;\n    font-size: 1.5rem;\n}\n\n.test-component-b .status {\n    padding: var(--space-xs) var(--space);\n    border-radius: var(--radius);\n    font-weight: bold;\n    font-size: 0.875rem;\n}\n\n.test-component-b .status.success {\n    background: var(--success-50);\n    color: var(--success-dark);\n    border: 1px solid var(--success);\n}\n\n.test-component-b .status.danger {\n    background: var(--danger-50);\n    color: var(--danger-dark);\n    border: 1px solid var(--danger);\n}\n\n.test-component-b .description {\n    color: var(--text-secondary);\n    margin-bottom: var(--space-lg);\n    line-height: 1.6;\n}\n\n.test-component-b .rating-section {\n    margin-bottom: var(--space-lg);\n    padding: var(--space);\n    background: var(--surface-50);\n    border-radius: var(--radius);\n}\n\n.test-component-b .rating-section h3 {\n    margin: 0 0 var(--space) 0;\n    color: var(--text);\n    font-size: 1.1rem;\n}\n\n.test-component-b .rating-controls {\n    display: flex;\n    flex-direction: column;\n    gap: var(--space);\n}\n\n.test-component-b .rating-stars {\n    font-size: 1.5rem;\n    color: var(--warning);\n    letter-spacing: 2px;\n}\n\n.test-component-b .star-selector {\n    display: flex;\n    gap: var(--space-xs);\n    flex-wrap: wrap;\n}\n\n.test-component-b .star {\n    padding: var(--space-xs) var(--space-sm);\n    font-size: 0.875rem;\n}\n\n.test-component-b .features-section {\n    margin-bottom: var(--space-lg);\n}\n\n.test-component-b .features-section h3 {\n    margin: 0 0 var(--space) 0;\n    color: var(--text);\n    font-size: 1.1rem;\n}\n\n.test-component-b .features-list {\n    margin-bottom: var(--space);\n}\n\n.test-component-b .features-list ul {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n}\n\n.test-component-b .feature-item {\n    display: flex;\n    align-items: center;\n    gap: var(--space);\n    padding: var(--space-sm) var(--space);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    margin-bottom: var(--space-xs);\n    background: var(--surface);\n    transition: var(--transition);\n}\n\n.test-component-b .feature-item:hover {\n    background: var(--surface-50);\n    border-color: var(--border-dark);\n}\n\n.test-component-b .feature-icon {\n    color: var(--accent);\n    font-size: 1.1rem;\n}\n\n.test-component-b .feature-text {\n    color: var(--text);\n    flex: 1;\n}\n\n.test-component-b .no-features {\n    color: var(--text-tertiary);\n    font-style: italic;\n    text-align: center;\n    padding: var(--space);\n    background: var(--surface-50);\n    border-radius: var(--radius);\n    border: 1px dashed var(--border);\n}\n\n.test-component-b .feature-form {\n    display: flex;\n    gap: var(--space);\n    margin-top: var(--space);\n}\n\n.test-component-b .feature-form input {\n    flex: 1;\n    padding: var(--space);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    background: var(--surface);\n    color: var(--text);\n}\n\n.test-component-b .controls {\n    display: flex;\n    gap: var(--space);\n    margin-bottom: var(--space);\n    flex-wrap: wrap;\n}\n\n.test-component-b .component-info {\n    text-align: center;\n    color: var(--text-tertiary);\n    font-style: italic;\n    padding-top: var(--space);\n    border-top: 1px solid var(--border);\n}\n\n/* Темная тема */\n[data-theme=\"dark\"] .test-component-b .rating-section {\n    background: var(--surface-100);\n}\n\n[data-theme=\"dark\"] .test-component-b .feature-item {\n    background: var(--surface-100);\n}\n\n[data-theme=\"dark\"] .test-component-b .no-features {\n    background: var(--surface-100);\n}\n\n/* Адаптивность */\n@media (max-width: 768px) {\n    .test-component-b .header {\n        flex-direction: column;\n        align-items: flex-start;\n    }\n\n    .test-component-b .rating-controls {\n        align-items: center;\n    }\n\n    .test-component-b .star-selector {\n        justify-content: center;\n    }\n\n    .test-component-b .feature-form {\n        flex-direction: column;\n    }\n\n    .test-component-b .controls {\n        flex-direction: column;\n    }\n}\n\n/* Анимации для интерактивных элементов */\n.test-component-b .star {\n    transition: var(--transition);\n}\n\n.test-component-b .star:hover {\n    transform: scale(1.1);\n    box-shadow: var(--shadow);\n}\n\n.test-component-b .feature-item {\n    transition: var(--transition);\n}\n\n.test-component-b .btn-toggle,\n.test-component-b .btn-add-feature {\n    transition: var(--transition);\n}\n\n.test-component-b .btn-toggle:hover,\n.test-component-b .btn-add-feature:hover {\n    transform: translateY(-1px);\n    box-shadow: var(--shadow-md);\n}\n\n/* Состояния загрузки */\n.test-component-b.loading .feature-item,\n.test-component-b.loading .rating-stars,\n.test-component-b.loading .controls {\n    opacity: 0.7;\n    pointer-events: none;\n}\n\n/* Доступность */\n.test-component-b .star:focus-visible {\n    outline: 2px solid var(--primary);\n    outline-offset: 2px;\n}\n\n.test-component-b .feature-form input:focus-visible {\n    outline: 2px solid var(--primary);\n    outline-offset: 2px;\n}\n\n/* Высокий контраст */\n@media (prefers-contrast: high) {\n    .test-component-b {\n        border: 2px solid var(--text);\n    }\n\n    .test-component-b .feature-item {\n        border: 2px solid var(--text);\n    }\n\n    .test-component-b .status {\n        border: 2px solid currentColor;\n    }\n}\n\n/* src/index.css */\n@import url('./scroll.css');\nhtml:not(.loaded) {\n    --scrollbar-transition: none !important;\n}\n\nhtml:not(.loaded)::-webkit-scrollbar {\n    transition: none !important;\n}\n\nhtml.no-transitions {\n    --scrollbar-transition: none !important;\n}\n\nhtml.no-transitions * {\n    transition: none !important;\n    animation: none !important;\n}\n\nhtml.no-transitions::-webkit-scrollbar {\n    transition: none !important;\n}\n\nbody {\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    min-height: 100vh;\n    margin: 0;\n    padding: 20px;\n    font-family: 'Rubik', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n}\n\n.container {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 20px;\n}\n\nh1 {\n    text-align: center;\n    color: white;\n    margin-bottom: 40px;\n    font-size: 2.5rem;\n    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);\n}\n\n.components-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));\n    gap: 30px;\n}\n\n.component-section {\n    background: rgba(255, 255, 255, 0.95);\n    border-radius: 15px;\n    padding: 25px;\n    box-shadow: 0 10px 30px rgba(0,0,0,0.2);\n    backdrop-filter: blur(10px);\n    border: 1px solid rgba(255,255,255,0.3);\n    margin-bottom: 40px;\n}\n\n.component-section h2 {\n    color: #4e54c8;\n    margin-bottom: 20px;\n    text-align: center;\n    border-bottom: 2px solid #4e54c8;\n    padding-bottom: 10px;\n}\n\n.demo-controls {\n    background: rgba(255, 255, 255, 0.9);\n    border-radius: 10px;\n    padding: 20px;\n    border: 1px solid rgba(0,0,0,0.1);\n    margin-bottom: 40px;\n}\n\n.demo-controls h3 {\n    color: #4e54c8;\n    margin-bottom: 15px;\n}\n\n.control-buttons {\n    display: flex;\n    gap: 10px;\n    flex-wrap: wrap;\n    margin-bottom: 15px;\n}\n\n.control-buttons button {\n    padding: 10px 15px;\n    border: none;\n    border-radius: 6px;\n    background: #4e54c8;\n    color: white;\n    cursor: pointer;\n    transition: all 0.3s ease;\n    font-family: inherit;\n}\n\n.control-buttons button:hover {\n    background: #3f43a5;\n    transform: translateY(-2px);\n}\n\n.info-panel {\n    background: rgba(79, 70, 229, 0.1);\n    border: 1px solid rgba(79, 70, 229, 0.2);\n    border-radius: 8px;\n    padding: 15px;\n    margin-top: 20px;\n}\n\n.info-panel h4 {\n    color: #4f46e5;\n    margin: 0 0 10px 0;\n}\n\n.info-panel pre {\n    background: rgba(0,0,0,0.05);\n    padding: 10px;\n    border-radius: 4px;\n    overflow-x: auto;\n    font-size: 0.9em;\n}\n\n.theme-toggle {\n    position: fixed;\n    top: 20px;\n    right: 20px;\n    background: rgba(255,255,255,0.9);\n    border: none;\n    border-radius: 50%;\n    width: 50px;\n    height: 50px;\n    cursor: pointer;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.2);\n    font-size: 1.2rem;\n    transition: all 0.3s ease;\n}\n\n.theme-toggle:hover {\n    transform: scale(1.1);\n    background: white;\n}\n\n@media (max-width: 768px) {\n    .components-grid {\n        grid-template-columns: 1fr;\n    }\n\n    h1 {\n        font-size: 2rem;\n    }\n}\n\nbody {\n    margin: 0;\n    padding: 0;\n    background: white; /* Убираем фон у body, оставляя только у html */\n}\n\nhtml {\n    visibility: hidden;\n}\n\n.visible {\n    visibility: visible;\n}\n\n:root {\n    /* Основные цвета - обновленная палитра */\n    --primary: #4e54c8;\n    --primary-dark: #3f43a5;\n    --primary-darker: #323583;\n    --primary-50: #f0f2ff;\n    --primary-100: #e0e7ff;\n\n    --secondary: #8f94fb;\n    --secondary-dark: #767ae9;\n\n    --accent: #ff6b6b;\n    --accent-dark: #ff5252;\n    --accent-darker: #e04848;\n\n    /* Текст */\n    --text: #2d3748;\n    --text-secondary: #718096;\n    --text-tertiary: #a0aec0;\n\n    /* Поверхности */\n    --background: #f7fafc;\n    --surface: #ffffff;\n    --surface-50: #f8fafc;\n    --surface-100: #f1f5f9;\n    --surface-200: #e2e8f0;\n    --surface-300: #cbd5e1;\n\n    /* Границы */\n    --border: #e2e8f0;\n    --border-subtle: #f1f5f9;\n    --border-dark: #cbd5e1;\n\n    /* Семантические цвета */\n    --success: #48bb78;\n    --success-dark: #38a169;\n    --success-50: #f0fff4;\n    --success-100: #c6f6d5;\n\n    --warning: #ed8936;\n    --warning-dark: #dd6b20;\n    --warning-50: #fffaf0;\n    --warning-100: #feebc8;\n\n    --info: #4299e1;\n    --info-dark: #3182ce;\n    --info-50: #ebf8ff;\n    --info-100: #bee3f8;\n\n    --danger: #f56565;\n    --danger-dark: #e53e3e;\n    --danger-50: #fff5f5;\n    --danger-100: #fed7d7;\n\n    /* Тени */\n    --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);\n    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);\n    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);\n\n    /* Анимации */\n    --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n    --transition-slow: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n\n    /* Шрифты */\n    --font-main: 'Rubik', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n    --font-mono: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;\n\n    /* Радиусы */\n    --radius-sm: 4px;\n    --radius: 6px;\n    --radius-md: 8px;\n    --radius-lg: 12px;\n\n    /* Отступы */\n    --space-xs: 4px;\n    --space-sm: 8px;\n    --space: 12px;\n    --space-md: 16px;\n    --space-lg: 20px;\n    --space-xl: 24px;\n}\n\n/* Темная тема */\n[data-theme=\"dark\"] {\n    --primary: #6366f1;\n    --primary-dark: #4f46e5;\n    --primary-darker: #4338ca;\n    --primary-50: #1e1b4b;\n    --primary-100: #312e81;\n\n    --secondary: #818cf8;\n    --secondary-dark: #6366f1;\n\n    --accent: #f87171;\n    --accent-dark: #ef4444;\n    --accent-darker: #dc2626;\n\n    --text: #f1f5f9;\n    --text-secondary: #cbd5e1;\n    --text-tertiary: #94a3b8;\n\n    --background: #0f172a;\n    --surface: #1e293b;\n    --surface-50: #1e293b;\n    --surface-100: #334155;\n    --surface-200: #475569;\n    --surface-300: #64748b;\n\n    --border: #334155;\n    --border-subtle: #1e293b;\n    --border-dark: #475569;\n\n    --success: #34d399;\n    --success-dark: #10b981;\n    --success-50: #064e3b;\n    --success-100: #065f46;\n\n    --warning: #fbbf24;\n    --warning-dark: #f59e0b;\n    --warning-50: #78350f;\n    --warning-100: #92400e;\n\n    --info: #60a5fa;\n    --info-dark: #3b82f6;\n    --info-50: #1e3a8a;\n    --info-100: #1e40af;\n\n    --danger: #f87171;\n    --danger-dark: #ef4444;\n    --danger-50: #7f1d1d;\n    --danger-100: #991b1b;\n\n    --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.3), 0 1px 2px 0 rgba(0, 0, 0, 0.2);\n    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.3), 0 2px 4px -1px rgba(0, 0, 0, 0.2);\n    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -2px rgba(0, 0, 0, 0.2);\n}\n\n/* Базовые стили */\n* {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n}\n\nbody {\n    font-family: var(--font-main);\n    /*background-color: var(--background);*/\n    color: var(--text);\n    line-height: 1.6;\n    transition: var(--transition-slow);\n    overflow-y: scroll;\n}\n\n/* Типография */\nh1, h2, h3, h4, h5, h6 {\n    color: var(--text);\n    font-weight: 600;\n    line-height: 1.3;\n    margin-bottom: var(--space);\n}\n\nh1 { font-size: 2rem; }\nh2 { font-size: 1.75rem; }\nh3 { font-size: 1.5rem; }\nh4 { font-size: 1.25rem; }\nh5 { font-size: 1.125rem; }\nh6 { font-size: 1rem; }\n\np {\n    margin-bottom: var(--space);\n    color: var(--text-secondary);\n}\n\n/* Кнопки */\nbutton {\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 500;\n    border: none;\n    border-radius: var(--radius);\n    cursor: pointer;\n    transition: var(--transition);\n    outline: none;\n    position: relative;\n    overflow: hidden;\n}\n\nbutton:disabled {\n    opacity: 0.6;\n    cursor: not-allowed;\n    transform: none !important;\n}\n\n/* Формы */\ninput, textarea, select {\n    font-family: inherit;\n    font-size: 14px;\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    background-color: var(--surface);\n    color: var(--text);\n    transition: var(--transition);\n    outline: none;\n}\n\ninput:focus, textarea:focus, select:focus {\n    border-color: var(--primary);\n    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 20%, transparent);\n}\n\n/* Утилиты */\n.container {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 var(--space-md);\n}\n\n.card {\n    background: var(--surface);\n    border-radius: var(--radius-md);\n    box-shadow: var(--shadow);\n    border: 1px solid var(--border);\n    transition: var(--transition);\n}\n\n.card:hover {\n    box-shadow: var(--shadow-md);\n}\n\n/* Анимации */\n@keyframes fadeIn {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes slideIn {\n    from { transform: translateX(-100%); }\n    to { transform: translateX(0); }\n}\n\n@keyframes pulse {\n    0%, 100% { opacity: 1; }\n    50% { opacity: 0.7; }\n}\n\n@keyframes spin {\n    to { transform: rotate(360deg); }\n}\n\n/* Модальные окна */\n.yato-modal-backdrop {\n    position: fixed;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background-color: rgba(0, 0, 0, 0.5);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 1000;\n    animation: fadeIn 0.2s ease-out;\n}\n\n.yato-modal-wrapper {\n    background: var(--surface);\n    border-radius: var(--radius-lg);\n    box-shadow: var(--shadow-lg);\n    max-width: 500px;\n    width: 90%;\n    max-height: 90vh;\n    overflow: hidden;\n    animation: fadeIn 0.3s ease-out;\n}\n\n.yato-modal-content {\n    padding: var(--space-xl);\n}\n\n.yato-modal-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: var(--space-lg);\n    padding-bottom: var(--space);\n    border-bottom: 1px solid var(--border);\n}\n\n.yato-modal-title {\n    margin: 0;\n    color: var(--text);\n    font-size: 1.25rem;\n}\n\n.yato-modal-close-button {\n    background: none;\n    border: none;\n    font-size: 1.5rem;\n    color: var(--text-tertiary);\n    cursor: pointer;\n    padding: var(--space-xs);\n    border-radius: var(--radius);\n    transition: var(--transition);\n}\n\n.yato-modal-close-button:hover {\n    background-color: var(--surface-100);\n    color: var(--text);\n}\n\n.yato-modal-body {\n    margin-bottom: var(--space-lg);\n    color: var(--text-secondary);\n}\n\n.yato-modal-footer {\n    display: flex;\n    gap: var(--space);\n    justify-content: flex-end;\n    padding-top: var(--space);\n    border-top: 1px solid var(--border);\n}\n\n.yato-button {\n    padding: var(--space) var(--space-lg);\n    border-radius: var(--radius);\n    font-weight: 500;\n    transition: var(--transition);\n    border: none;\n    cursor: pointer;\n}\n\n.yato-button.primary {\n    background-color: var(--primary);\n    color: white;\n}\n\n.yato-button.primary:hover {\n    background-color: var(--primary-dark);\n    transform: translateY(-1px);\n    box-shadow: var(--shadow-md);\n}\n\n.yato-button.secondary {\n    background-color: var(--surface-100);\n    color: var(--text);\n    border: 1px solid var(--border);\n}\n\n.yato-button.secondary:hover {\n    background-color: var(--surface-200);\n    border-color: var(--border-dark);\n}\n\n/* Загрузка */\n.loading-spinner {\n    display: inline-block;\n    width: 16px;\n    height: 16px;\n    border: 2px solid transparent;\n    border-top: 2px solid currentColor;\n    border-radius: 50%;\n    animation: spin 1s linear infinite;\n}\n\n/* Адаптивность */\n@media (max-width: 768px) {\n    :root {\n        --space-xl: 20px;\n        --space-lg: 16px;\n        --space-md: 12px;\n        --space: 10px;\n    }\n\n    .container {\n        padding: 0 var(--space);\n    }\n\n    h1 { font-size: 1.75rem; }\n    h2 { font-size: 1.5rem; }\n    h3 { font-size: 1.25rem; }\n}\n\n@media (max-width: 480px) {\n    .yato-modal-content {\n        padding: var(--space-lg);\n    }\n\n    .yato-modal-footer {\n        flex-direction: column;\n    }\n\n    .yato-button {\n        width: 100%;\n    }\n}\n\n/* Доступность */\n@media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after {\n        animation-duration: 0.01ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: 0.01ms !important;\n    }\n}\n\n/* Фокус для доступности */\nbutton:focus-visible,\ninput:focus-visible,\ntextarea:focus-visible,\nselect:focus-visible {\n    outline: 2px solid var(--primary);\n    outline-offset: 2px;\n}\n\n/* Высокий контраст */\n@media (prefers-contrast: high) {\n    :root {\n        --border: #000000;\n        --shadow: 0 2px 4px rgba(0, 0, 0, 0.5);\n    }\n\n    [data-theme=\"dark\"] {\n        --border: #ffffff;\n    }\n}\n\n\nbody {\n    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n    min-height: 100vh;\n    margin: 0;\n    padding: 20px;\n    font-family: 'Rubik', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n}\n\n/* src/scroll/scroll.css */\n/* Стили для скроллбара */\n:root {\n    --scrollbar-opacity: 0;\n    --scrollbar-visibility: hidden;\n    --scrollbar-transition: opacity 0.3s ease, visibility 0.3s ease;\n    --background: white;\n}\n\n/* Для Firefox - делаем трек прозрачным */\nhtml {\n    scrollbar-width: thin;\n    /*scrollbar-color: rgba(100, 116, 139, 0) transparent;*/\n    /*transition: scrollbar-color 0.3s ease;*/\n    background: var(--background);\n    scrollbar-color: transparent rgba(15, 23, 42, 0.8); /* Для Firefox */\n    scrollbar-width: thin; /* Для Firefox */\n}\n\n\n\n/* Для вебкит браузеров */\n::-webkit-scrollbar {\n    width: 12px;\n    opacity: var(--scrollbar-opacity);\n    visibility: var(--scrollbar-visibility);\n    transition: var(--scrollbar-transition);\n}\n\n\n/* Состояние при прокрутке */\nhtml.scrolling {\n    --scrollbar-opacity: 1;\n    --scrollbar-visibility: visible;\n}\n\nhtml.scrolling::-webkit-scrollbar {\n    opacity: 1;\n    visibility: visible;\n}\n\nhtml.scrolling::-webkit-scrollbar-thumb {\n    opacity: 1;\n}\n\nhtml.scrolling {\n    scrollbar-color: rgba(100, 116, 139, 0.8) transparent;\n}\n\n\n/* src/scroll.css */\n/* Стили для скроллбара */\n:root {\n    --scrollbar-opacity: 0;\n    --scrollbar-visibility: hidden;\n    --scrollbar-transition: opacity 0.3s ease, visibility 0.3s ease;\n    --background: white;\n}\n\n/* Для Firefox - делаем трек прозрачным */\nhtml {\n    scrollbar-width: thin;\n    /*scrollbar-color: rgba(100, 116, 139, 0) transparent;*/\n    /*transition: scrollbar-color 0.3s ease;*/\n    background: var(--background);\n    scrollbar-color: transparent rgba(15, 23, 42, 0.8); /* Для Firefox */\n    scrollbar-width: thin; /* Для Firefox */\n}\n\n\n\n/* Для вебкит браузеров */\n::-webkit-scrollbar {\n    width: 12px;\n    opacity: var(--scrollbar-opacity);\n    visibility: var(--scrollbar-visibility);\n    transition: var(--scrollbar-transition);\n}\n\n\n/* Состояние при прокрутке */\nhtml.scrolling {\n    --scrollbar-opacity: 1;\n    --scrollbar-visibility: visible;\n}\n\nhtml.scrolling::-webkit-scrollbar {\n    opacity: 1;\n    visibility: visible;\n}\n\nhtml.scrolling::-webkit-scrollbar-thumb {\n    opacity: 1;\n}\n\nhtml.scrolling {\n    scrollbar-color: rgba(100, 116, 139, 0.8) transparent;\n}\n\n\n";
const cssPaths = ["src/components/navigation-manager/css/index.css","src/components/test-component-a/css/index.css","src/components/test-component-b/css/index.css","src/index.css","src/scroll/scroll.css","src/scroll.css"];
const componentCSSMap = {"navigation-manager":["src/components/navigation-manager/css/index.css"],"test-component-a":["src/components/test-component-a/css/index.css"],"test-component-b":["src/components/test-component-b/css/index.css"],"src":["src/index.css","src/scroll.css"],"scroll":["src/scroll/scroll.css"]};

export function getCSSByPath(filePath) {
  const normalizedPath = filePath.replace(/\\/g, "/");
  const entry = cssPaths.find(path => path.replace(/\\/g, "/").includes(normalizedPath));
  
  if (entry) {
    const startMarker = "/* " + entry + " */";
    const startIndex = cssContent.indexOf(startMarker) + startMarker.length;
    let endIndex = cssContent.length;
    
    for (let i = cssPaths.indexOf(entry) + 1; i < cssPaths.length; i++) {
      const nextMarker = "/* " + cssPaths[i] + " */";
      const nextIndex = cssContent.indexOf(nextMarker);
      if (nextIndex !== -1) {
        endIndex = nextIndex;
        break;
      }
    }
    
    return cssContent.substring(startIndex, endIndex).trim();
  }
  return null;
}

export function getCSSForComponent(componentName) {
  const componentPaths = componentCSSMap[componentName];
  if (!componentPaths) return null;
  
  return componentPaths.map(path => getCSSByPath(path)).filter(Boolean).join("\n");
}

export function getAllCSS() {
  return cssContent;
}

export function injectCSS() {
  if (typeof document !== "undefined") {
    const style = document.createElement("style");
    style.textContent = cssContent;
    document.head.appendChild(style);
  }
}

export function getCSSPaths() {
  return cssPaths;
}

export function getMultipleCSS(paths) {
  return paths.map(path => getCSSByPath(path)).filter(Boolean).join("\n");
}

export function getComponentCSSMap() {
  return componentCSSMap;
}

export default cssContent;
