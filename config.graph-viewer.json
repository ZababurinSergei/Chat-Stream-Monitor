{
  "directories": [
    {
      "id": "1",
      "name": "packages/ast-analyzer/ast-graph-viewer",
      "description": "Пользовательские файлы: исходники, шаблоны, проекты, пользовательские данные",
      "description_en": "User files: sources, templates, projects, user data",
      "required": false,
      "excluded": false
    },
    {
      "id": "2",
      "name": "packages/ast-analyzer/src/reporters/codec",
      "description": "Пользовательские файлы: исходники, шаблоны, проекты, пользовательские данные",
      "description_en": "User files: sources, templates, projects, user data",
      "required": false,
      "excluded": true
    },
    {
      "id": "3",
      "name": "packages/ast-analyzer/scripts",
      "description": "Пользовательские файлы: исходники, шаблоны, проекты, пользовательские данные",
      "description_en": "User files: sources, templates, projects, user data",
      "required": false,
      "excluded": true
    }
  ],
  "excludePatterns": {
    "directories": [
      "docs",
      "__tests__",
      "examples",
      "reports",
      "formal/__tests__",
      "refactor/__tests__",
      "test-temp-stress",
      "tests",
      "venv",
      "third_party",
      "aedes",
      "metaflow-tutorials",
      ".vite-cache",
      "migration_commits",
      "cache",
      ".turbo",
      ".github",
      ".idea",
      "node_modules",
      ".git",
      "dist",
      "build",
      "coverage",
      ".nyc_output",
      "__pycache__",
      ".cache",
      "logs"
    ],
    "files": [
      "index.json",
      "index.full.json",
      "packages/ast-analyzer/setup-aliases.sh",
      "packages/ast-analyzer/commands.md",
      "packages/ast-analyzer/README.refactoring.md",
      "packages/ast-analyzer/report_е.html",
      "__node_globals.d.ts",
      "analize.file.md",
      "packages/ast-analyzer/globals.d.ts",
      "packages/ast-analyzer/index.html",
      "packages/ast-analyzer/tsconfig.analyzer.json",
      "esbuild.bundle.config.js",
      "esbuild.cli.config.js",
      "commands.md",
      "interactive-report.template.html",
      "interactive-report.js",
      "interactive-report.css",
      "data-converter.js",
      "analysis-result.json",
      "README.md",
      "LICENSE.md",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml",
      ".DS_Store",
      "Thumbs.db",
      "*.log",
      "*.tmp",
      "*.swp"
    ]
  },
  "scanOptions": {
    "recursive": true,
    "followSymlinks": false,
    "maxDepth": 100,
    "excludeExcludedDirs": true,
    "respectExcludePatterns": true
  },
  "output": {
    "fileName": "./fs/fs.json",
    "prettyPrint": true,
    "includeMetadata": true
  },
  "report": {
    "enabled": true,
    "path": "./logs/scan_report.log",
    "append": false,
    "includeTimestamp": true,
    "includeSystemInfo": true,
    "language": "russian"
  },
  "supportedExtensions": [
    ".yaml",
    ".js",
    ".mjs",
    ".cjs",
    ".ts",
    ".tsx",
    ".jsx",
    ".vue",
    ".json",
    ".css",
    ".html",
    ".md",
    ".txt",
    ".py",
    ".java",
    ".go",
    ".h",
    ".c",
    ".d",
    ".sh",
    ".ini",
    ".nix",
    ".csv",
    ".rpkg"
  ],
  "specialFiles": [
    "pre-push",
    "pre-commit",
    "Dockerfile",
    "Makefile",
    ".gitignore",
    ".gitmodules",
    ".env",
    ".jshintrc",
    ".jshintignore",
    ".npmrc"
  ]
}
